# ==============================================================================
# SIH ID 26001: MDoNER Landslide Risk Monitoring System
# Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env in each service directory and fill in production values.
# NEVER commit .env files with real secrets to version control.

# ─── POSTGRESQL / POSTGIS DATABASE ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@localhost:5432/mdoner_gis

# ─── REDIS CACHE & PUB/SUB ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── ECLIPSE MOSQUITTO MQTT BROKER ─────────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=mdoner/ner/sensor/+/telemetry

# ─── FASTAPI BACKEND TARGET (for MQTT Worker) ──────────────────────────────────
FASTAPI_INGEST_URL=http://localhost:8000/api/v1/telemetry

# ─── INDIAN DLT SMS GATEWAY ────────────────────────────────────────────────────
SMS_DLT_SENDER_ID=MDONER
SMS_DLT_TEMPLATE_ID=1407161829000123
SMS_GATEWAY_API_KEY=your_sms_api_key_here

# ─── WHATSAPP BUSINESS GRAPH API ───────────────────────────────────────────────
WHATSAPP_API_TOKEN=your_whatsapp_bearer_token_here
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id

# ─── CORS ORIGINS (comma-separated for production) ─────────────────────────────
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,https://mdoner.gov.in

# ─── UVICORN SERVER SETTINGS ───────────────────────────────────────────────────
UVICORN_WORKERS=2
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# ─── TELEGRAM REAL-TIME ALERT BOT ─────────────────────────────────────────────
# Bot token from @BotFather; keep this secret.
TELEGRAM_BOT_TOKEN=
# Public HTTPS endpoint used by Telegram to push updates to the webhook.
# Example: https://your-domain.example.com/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Optional secret sent by Telegram in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
# Dashboard URL embedded in the Evacuation Route button.
GIS_DASHBOARD_URL=http://localhost:3000
